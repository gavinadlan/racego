# Salin ke .env lalu sesuaikan:  cp .env.example .env
# Backend membaca variabel ini dari environment (Makefile memuat .env otomatis).

APP_ENV=development
HTTP_ADDR=:8080
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgres://racego:racego@localhost:55432/racego?sslmode=disable
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=

# Kosongkan untuk mode MOCK (tanpa Midtrans sungguhan, pembayaran disimulasikan).
# Isi dengan Server Key sandbox dari https://dashboard.sandbox.midtrans.com untuk uji Snap asli.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Kunci privat Ed25519 (base64) untuk menandatangani QR tiket.
# Buat dengan: make keygen   — kosong di development = kunci dev bawaan (JANGAN dipakai di produksi).
QR_PRIVATE_KEY=

# Lama slot ditahan setelah reservasi
RESERVATION_TTL=15m

# Development: Mailpit (lihat email di http://localhost:8025). Demo online: SMTP Resend (smtp.resend.com:587, user "resend", password = API key)
SMTP_ADDR=localhost:1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=RaceGo <no-reply@racego.local>

# Frontend (Next.js) — URL backend yang dipanggil dari browser
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
