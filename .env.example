# Salin ke .env lalu sesuaikan:  cp .env.example .env
# Backend membaca variabel ini dari environment (Makefile memuat .env otomatis).

APP_ENV=development
HTTP_ADDR=:8080
FRONTEND_URL=http://localhost:3000
# Jumlah proxy tepercaya di depan API. 0 = API langsung diakses: X-Forwarded-For/X-Real-IP diabaikan
# (bisa dipalsukan untuk mengakali batas kode OTP per IP). Stack produksi (Caddy di depan API): 1, lihat docs/10-deploy.md.
TRUSTED_PROXY_HOPS=0

DATABASE_URL=postgres://racego:racego@localhost:55432/racego?sslmode=disable
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=

# Kosongkan untuk mode MOCK (tanpa Midtrans sungguhan, pembayaran disimulasikan).
# Isi dengan Server Key sandbox dari https://dashboard.sandbox.midtrans.com untuk uji Snap asli.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Kunci privat Ed25519 (base64) untuk menandatangani QR tiket.
# Buat dengan: make keygen   — kosong di development = kunci dev bawaan (JANGAN dipakai di produksi).
QR_PRIVATE_KEY=

# Lama slot ditahan setelah reservasi
RESERVATION_TTL=15m

# Antrian virtual (waiting room) untuk event yang mengaktifkannya. Lihat docs/03-war-tiket.md.
# Kunci HMAC pass antrian: kosong di development = kunci dev bawaan. Produksi wajib (scripts/gen-secrets.sh).
QUEUE_SECRET=
QUEUE_LOBBY_MINUTES=15
QUEUE_ADMIT_PER_SEC=20
QUEUE_MAX_ACTIVE=300
QUEUE_PASS_TTL=10m
QUEUE_HEARTBEAT_TTL=45s

# Penyelenggara baru langsung terverifikasi (boleh menerbitkan event), melewati alur verifikasi.
# Isi false untuk mencoba alur verifikasi (/org/{slug}/verifikasi + /admin, butuh make superadmin).
AUTO_VERIFY_ORGS=true

# Folder poster & logo unggahan mitra (relatif ke folder backend). Di server: disk persisten + ikut backup.
UPLOAD_DIR=./data/uploads

# Verifikasi mitra (KYC): dokumen & NIK/rekening/NPWP disimpan terenkripsi AES-256-GCM.
# Kunci base64 32 byte (openssl rand -base64 32). Kosong di development = kunci dev bawaan (+ peringatan di log).
# Kunci hilang/berubah = semua dokumen & data terenkripsi TIDAK BISA dibuka lagi.
KYC_ENC_KEY=
# Folder privat dokumen terenkripsi (di luar UPLOAD_DIR, tidak pernah disajikan statis).
KYC_DIR=./data/kyc

# Development: Mailpit (lihat email di http://localhost:8025). Demo online: SMTP Resend (smtp.resend.com:587, user "resend", password = API key)
SMTP_ADDR=localhost:1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=RaceGo <no-reply@racego.local>

# Frontend (Next.js) — URL backend yang dipanggil dari browser. Build produksi memakai "" (relatif,
# satu origin di belakang Caddy); file ini hanya untuk development.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Tampilkan pemilih "Akun contoh (dev)" di header (header X-User-ID, hanya diterima backend saat APP_ENV=development).
# Build produksi (frontend/Dockerfile) selalu false.
NEXT_PUBLIC_DEV_LOGIN=true
