# Konfigurasi stack produksi (docker-compose.prod.yml). Panduan: docs/10-deploy.md
#   cp .env.prod.example .env.prod && scripts/gen-secrets.sh
# .env.prod berisi rahasia dan di-ignore Git. JANGAN di-commit, cadangkan di tempat aman.

# ===== Alamat web =====
# Domain publik (sertifikat HTTPS otomatis dari Let's Encrypt; port 80 & 443 harus terbuka):
#   SITE_ADDRESS=racego.example.com   atau   SITE_ADDRESS=racego-kamu.duckdns.org
# Uji di laptop: SITE_ADDRESS=localhost (sertifikat lokal Caddy, browser akan memperingatkan).
# FRONTEND_URL tidak perlu diisi: otomatis https://$SITE_ADDRESS.
SITE_ADDRESS=localhost

# ===== Topologi proxy (lihat tabel di docs/10-deploy.md) =====
# direct: browser → Caddy → API. tunnel: Cloudflare Tunnel → Caddy → API (isi juga CADDY_BIND=127.0.0.1).
PROXY_MODE=direct
# Alamat host tempat Caddy membuka port 80/443. 127.0.0.1 = hanya dari mesin ini (mode tunnel).
CADDY_BIND=0.0.0.0
# Caddy satu-satunya proxy di depan API pada kedua topologi.
TRUSTED_PROXY_HOPS=1

# ===== Rahasia (diisi scripts/gen-secrets.sh) =====
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Kunci HMAC pass antrian virtual (min. 32 karakter). Mengganti = semua pass yang sedang dipegang pembeli batal.
QUEUE_SECRET=
# Kunci tanda tangan QR tiket. JANGAN PERNAH diganti setelah ada tiket terbit: semua QR lama jadi tidak sah.
# Simpan salinannya di luar server (pengelola password).
QR_PRIVATE_KEY=

# ===== Mitra =====
# false = penyelenggara baru harus diverifikasi manual (make prod-verify ORG=slug). Demo boleh true.
AUTO_VERIFY_ORGS=false

# ===== Midtrans (sandbox) =====
# Kosong = mode MOCK (pembayaran disimulasikan). Isi kunci sandbox dari https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
# Client key tertanam ke bundle frontend saat build (bukan rahasia). Ubah = make prod-up (build ulang).
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ===== Email (kode masuk, tiket) =====
# Gmail: smtp.gmail.com:587, user = alamat Gmail, password = App Password (bukan password akun).
# Resend: smtp.resend.com:587, user = resend, password = API key.
SMTP_ADDR=smtp.gmail.com:587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=RaceGo <alamat-kamu@gmail.com>

# ===== Opsional =====
# Lama slot tiket ditahan setelah reservasi.
RESERVATION_TTL=15m
# Antrian virtual (event yang mengaktifkannya), lihat docs/03-war-tiket.md. Default cocok untuk server kecil.
# Lobi dibuka sekian menit sebelum penjualan; urutan peserta lobi diacak saat jam buka.
QUEUE_LOBBY_MINUTES=15
# Pembeli dipanggil per detik per event, dan maksimum pemegang pass sekaligus.
QUEUE_ADMIT_PER_SEC=20
QUEUE_MAX_ACTIVE=300
# Masa berlaku pass; tanpa polling selama QUEUE_HEARTBEAT_TTL = keluar antrian.
QUEUE_PASS_TTL=10m
QUEUE_HEARTBEAT_TTL=45s
# Port host Caddy bila 80/443 sudah dipakai (sertifikat Let's Encrypt butuh 80/443 asli).
HTTP_PORT=80
HTTPS_PORT=443
# Token Cloudflare Tunnel bernama (profile tunnel), lihat docs/10-deploy.md.
TUNNEL_TOKEN=
